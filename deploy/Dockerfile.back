ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
# Le lockfile vit à la racine des workspaces, et c'est `<racine>/node_modules`
# qui rend `bitecs` résolvable depuis `sim/`.
COPY package.json package-lock.json ./
COPY front/package.json front/
COPY back/package.json back/
RUN npm ci
COPY sim/ sim/
COPY back/ back/
WORKDIR /app/back
RUN npm run prisma:generate && npm run build

FROM node:${NODE_VERSION}-alpine AS app
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY front/package.json front/
COPY back/package.json back/
# Le `prepare` de la racine (`husky`) est un devDependency que `--omit=dev`
# retire, mais `npm ci` tente quand même de l'exécuter et échoue sur
# `sh: husky: not found` (exit 127) — constaté à l'exécution de cette étape,
# pas à l'inspection du Dockerfile. On neutralise CE script précis plutôt que
# tous les scripts d'installation (`--ignore-scripts` aurait aussi empêché le
# postinstall de `@prisma/engines`, seul responsable du téléchargement du
# binaire "schema engine" — sans lui `npx prisma migrate deploy` irait le
# chercher sur le réseau à chaque démarrage, et échouerait net sur un hôte
# sans accès sortant : reproduit sur un réseau Docker `--internal`, voir
# task-8-report.md).
RUN npm pkg delete scripts.prepare
# npm@10 (celui de cette image de base) laisse des devDependencies orphelines
# sur le disque après `npm ci --omit=dev` dans ce monorepo : `npm ls` les
# montre absentes de l'arbre résolu, mais les répertoires restent quand même
# (bug constaté par l'exécution, pas supposé). npm@11 corrige ce cas — épinglé
# à une version précise, jamais `npm install -g npm@latest` : npm@12 introduit
# un nouveau garde-fou qui BLOQUE par défaut les scripts d'installation des
# dépendances, ce qui aurait supprimé silencieusement le téléchargement du
# schema engine et réintroduit le bug ci-dessus sans la moindre erreur au
# build.
RUN npm install -g npm@11.19.0
# `--workspace back --include-workspace-root` : limiter l'installation au
# workspace `back` écarte les dépendances propres à `front` (pixi.js et son
# arbre), qui n'ont rien à faire dans cette image ; `--include-workspace-root`
# est nécessaire quand même, sinon les `dependencies` de la racine — dont
# `bitecs`, que `sim/` importe et qu'esbuild laisse external — disparaissent
# aussi.
RUN npm ci --omit=dev --workspace back --include-workspace-root
# `esbuild` a inliné `sim/` dans ce fichier : il n'y a rien d'autre à copier.
COPY --from=build /app/back/dist/ back/dist/
COPY --from=build /app/back/prisma/ back/prisma/
# Le client Prisma généré, et non `back/src/generated/` comme cette étape le
# prescrivait d'abord : la tâche 5 l'a sorti de `src/` parce qu'esbuild l'y
# avalait, et un client CJS inliné dans un bundle ESM plante au démarrage sur
# `Dynamic require of "node:fs" is not supported`. Trois tâches avaient
# inspecté le bundle au `grep` sans jamais l'exécuter.
#
# **Après** `npm ci --omit=dev`, jamais avant : l'installation réécrit
# `node_modules` et effacerait la copie.
COPY --from=build /app/node_modules/.prisma/ node_modules/.prisma/
WORKDIR /app/back
EXPOSE 3000
# Migrer puis servir : le conteneur ne doit pas répondre avant que le schéma
# soit à jour, sinon la première requête tombe sur une table absente.
#
# `prisma` vit dans `dependencies` de `back/package.json`, pas dans
# `devDependencies` (constat tâche 5) : avec `--omit=dev` ci-dessus, une CLI
# en devDependency serait absente de cette image, et `npx` irait la chercher
# sur le réseau à chaque démarrage — ou échouerait net sur un hôte sans accès
# sortant, comme le réseau Docker `--internal` du smoke test CI.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
