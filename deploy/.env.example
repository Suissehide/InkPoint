# Copie ce fichier en `deploy/.env` (git-ignoré), lu par `deploy/compose.yaml`.
#
# Les valeurs par défaut sont celles d'une machine locale. **Sur le serveur,
# trois lignes sont à reprendre** — les deux hôtes Traefik et le mot de passe
# Postgres. Elles sont signalées.
#
# `compose.yaml` reste un fichier de production : il attend un Traefik qui
# écoute sur le réseau externe `proxy` et termine le TLS. Pour le développement
# quotidien on ne le lance pas — voir « Running it locally » dans le README :
# Postgres seul via `deploy/compose.dev.yaml`, puis les deux serveurs de
# développement.

# ── Build / Registry ──────────────────────────────────────────────────────────
NODE_VERSION=22
APP_IMAGE_NAME=inkpoint
CONTAINER_REGISTRY_PREFIX=
VERSION=latest

# ── Traefik ───────────────────────────────────────────────────────────────────
# ⚠️ À REMPLACER SUR LE SERVEUR par les vrais noms d'hôtes.
# En local, le TLD `.localhost` résout vers 127.0.0.1 sans toucher à /etc/hosts.
TRAEFIK_FRONT_HOST=inkpoint.localhost
TRAEFIK_API_HOST=api.inkpoint.localhost

# ── Postgres ──────────────────────────────────────────────────────────────────
# `back` fabrique son `DATABASE_URL` à partir de ces trois valeurs ; il n'y a
# aucune URL à écrire ici.
POSTGRES_USER=inkpoint
# ⚠️ À REMPLACER SUR LE SERVEUR. Identique en local à celui de `compose.dev.yaml`
# à dessein : une base de développement jetable n'a rien à protéger, et deux mots
# de passe différents pour la même chose se paient en erreurs d'authentification.
POSTGRES_PASSWORD=inkpoint
POSTGRES_DB=inkpoint
