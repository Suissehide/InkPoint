{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": { "groups": [":NODE:", ":PACKAGE:", ":BLANK_LINE:", ":ALIAS:", ":PATH:"] }
        }
      }
    }
  },
  "files": { "includes": ["front/src/**", "back/src/**", "sim/**"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "javascript": {
    "formatter": { "semicolons": "asNeeded", "quoteStyle": "single" }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNamespace": "error",
        "useBlockStatements": "error",
        "useConsistentArrayType": "error",
        "useForOf": "error"
      },
      "suspicious": { "noEmptyBlockStatements": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["front/src/styles/main.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["sim/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixi.js": "sim/ doit rester pur : aucun import de rendu."
                },
                "patterns": [
                  {
                    "group": ["**/render/**", "**/ui/**", "**/app/**", "**/audio/**"],
                    "message": "sim/ ne connaît ni le rendu, ni l'UI, ni l'app, ni l'audio."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "sim/ ne touche pas au navigateur.",
                  "document": "sim/ ne touche pas au navigateur.",
                  "performance": "sim/ ne lit pas le temps réel.",
                  "localStorage": "sim/ ne persiste rien."
                }
              }
            }
          }
        }
      }
    }
  ]
}
