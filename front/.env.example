# Base de l'API du service de classement (`front/src/app/leaderboard-client.ts`).
# En développement, laisser cette variable absente : le client retombe sur
# http://localhost:3000. En production, pointer vers le sous-domaine api (voir
# TRAEFIK_API_HOST dans deploy/.env.example).
VITE_API_URL=https://api.inkpoint.dev
