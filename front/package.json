{
  "name": "inkpoint-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src ../sim",
    "format": "biome check --write src ../sim",
    "typecheck": "tsc --noEmit",
    "golden": "tsx ../sim/scripts/gen-golden.ts"
  },
  "dependencies": {
    "bitecs": "^0.3.40",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
